<Window x:Class="EdifierManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EdifierManager" Title="漫步者耳机助手" Icon="Assets/app.ico" Width="620" Height="680" MinWidth="540" MinHeight="560" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="12" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource PrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="14,10,14,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,9">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7F6;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" FontSize="21" Margin="0,0,9,0"/><TextBlock Text="EDIFIER" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="耳机助手" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,3,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border x:Name="PreviewBadge" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,8,0"><TextBlock Text="离线预览" FontSize="10"/></Border>
        <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{DynamicResource SecondaryBrush}" Margin="0,0,6,0"/><TextBlock x:Name="DeviceStatus" Text="未连接" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Click="Menu_Click" ToolTip="主题与更多操作" AutomationProperties.Name="主题与更多操作"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15"/>
          <Button.ContextMenu><ContextMenu><MenuItem Header="跟随系统主题" Tag="System" IsCheckable="True" IsChecked="True" Click="Theme_Click"/><MenuItem Header="浅色" Tag="Light" IsCheckable="True" Click="Theme_Click"/><MenuItem Header="深色" Tag="Dark" IsCheckable="True" Click="Theme_Click"/><Separator/><MenuItem Header="预览 W820NB" Tag="w820" Click="Preview_Click"/><MenuItem Header="预览 W830NB" Tag="w830" Click="Preview_Click"/><MenuItem Header="预览 Lolli ANC" Tag="lolli" Click="Preview_Click"/><MenuItem Header="退出预览 / 断开连接" Click="Disconnect_Click"/><Separator/><MenuItem Header="Windows 蓝牙设置" Click="BluetoothSettings_Click"/><MenuItem Header="Windows 声音设置" Click="SoundSettings_Click"/><MenuItem Header="打开备份目录" Click="OpenBackups_Click"/><Separator/><MenuItem Header="关于与许可证" Click="Licenses_Click"/></ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="9" Margin="0,0,0,7"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="Devices" MinHeight="30" VerticalContentAlignment="Center" AutomationProperties.Name="选择耳机" SelectionChanged="Devices_SelectionChanged"/>
        <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="Scan_Click" Margin="6,0,0,0" ToolTip="扫描耳机" AutomationProperties.Name="扫描耳机"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="15"/></Button>
        <Button x:Name="ConnectButton" Grid.Column="2" Content="连接设备" Click="Connect_Click" MinWidth="84" Margin="6,0,0,0"/>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="?" Click="Help_Click" Margin="6,0,0,0" ToolTip="连接帮助" AutomationProperties.Name="连接帮助"/>
      </Grid>
      <TextBlock x:Name="ConnectionText" Text="打开耳机，点击扫描后选择要连接的设备。" Style="{StaticResource Hint}" Margin="1,6,1,0"/>
      <Border x:Name="HelpPanel" Visibility="Collapsed" Background="{DynamicResource InsetBrush}" CornerRadius="5" Padding="8" Margin="0,7,0,0"><TextBlock Text="先在 Windows 蓝牙设置中配对。W820NB / W830NB 开机，Lolli ANC 取出充电盒。连接失败时关闭手机上的 EDIFIER Connect 后重试。此处连接用于管理设置，关闭窗口会释放连接。" Style="{StaticResource Hint}"/></Border>
    </StackPanel></Border>
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" x:Name="Tabs">
      <TabItem x:Name="HomeTab" Padding="14,7" Header="耳机"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel x:Name="HomeStack">
        <Border x:Name="WelcomePanel" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="尚未连接耳机" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="打开耳机，点击上方扫描按钮，然后选择并连接设备。" Style="{StaticResource Hint}"/></StackPanel></Border>
        <Border x:Name="BatteryCard" Style="{StaticResource Card}"><StackPanel>
          <Grid Margin="0,0,0,12"><TextBlock x:Name="ModelText" Text="W820NB / W830NB / Lolli ANC" FontWeight="SemiBold"/><TextBlock x:Name="UpdatedText" Text="等待连接" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
          <DockPanel><local:HeadsetArt x:Name="ProductArt" Width="90" Height="76" Margin="0,0,18,0" DockPanel.Dock="Left"/><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" Background="{DynamicResource InsetBrush}" CornerRadius="7" Margin="0,0,10,0"><TextBlock x:Name="LeftSymbol" Text="L" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="LeftLabel" Text="耳机电量" Style="{StaticResource Hint}"/><StackPanel Orientation="Horizontal"><local:BatteryGauge x:Name="LeftGauge" Width="28" Height="15" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="LeftBattery" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel></StackPanel></StackPanel>
            <StackPanel x:Name="RightBatteryPanel" Grid.Column="1" Orientation="Horizontal"><Border Width="34" Height="34" Background="{DynamicResource InsetBrush}" CornerRadius="7" Margin="0,0,10,0"><TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="右耳" Style="{StaticResource Hint}"/><StackPanel Orientation="Horizontal"><local:BatteryGauge x:Name="RightGauge" Width="28" Height="15" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="RightBattery" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel></StackPanel></StackPanel>
          </Grid></DockPanel>
          <Grid Margin="0,12,0,0"><TextBlock x:Name="FirmwareText" Text="固件 —" Style="{StaticResource Hint}"/><TextBlock x:Name="BoxText" Text="" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
          <Grid Margin="0,9,0,0"><TextBlock x:Name="CurrentModeText" Text="连接后读取耳机状态" Style="{StaticResource Hint}" VerticalAlignment="Center"/><Button x:Name="RefreshButton" Content="重新读取" Click="Refresh_Click" HorizontalAlignment="Right" MinHeight="25" Padding="8,2" IsEnabled="False"/></Grid>
        </StackPanel></Border>
        <Border x:Name="WearCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="入耳检测" Style="{StaticResource Heading}"/><TextBlock Text="摘下耳机后，音乐如何继续" Style="{StaticResource Hint}" Margin="0,0,0,8"/><Grid x:Name="WearPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="WearChoice" MinHeight="32" AutomationProperties.Name="入耳检测模式"/><Button Content="应用" Grid.Column="1" Click="WearApply_Click" Margin="6,0,0,0"/></Grid></StackPanel></Border>
        <Border x:Name="TwsQuickCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="声音与手势" Style="{StaticResource Heading}"/><WrapPanel><Button x:Name="GoSoundButton" Content="调整声音" Click="GoSound_Click" Margin="0,0,8,0"/><Button x:Name="GoTouchButton" Content="编辑触控" Click="GoTouch_Click"/></WrapPanel></StackPanel></Border>
        <Border x:Name="AudioCard" Style="{StaticResource Card}"><StackPanel x:Name="AudioPanel">
          <Grid Margin="0,0,0,8"><TextBlock Text="音量与麦克风" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="刷新" Click="AudioRefresh_Click" HorizontalAlignment="Right" MinHeight="25" Padding="8,2"/></Grid>
          <ComboBox MinHeight="30" VerticalContentAlignment="Center" x:Name="AudioDevices" SelectionChanged="AudioDevices_SelectionChanged" AutomationProperties.Name="耳机音频设备"/>
          <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Slider x:Name="AudioVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Windows 音量"/><TextBlock Grid.Column="1" Text="{Binding ElementName=AudioVolume,Path=Value,StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
          <Grid><CheckBox x:Name="AudioMute" Content="静音"/><Button x:Name="AudioApplyButton" Content="应用音量" Click="AudioApply_Click" HorizontalAlignment="Right" IsEnabled="False"/></Grid>
          <TextBlock x:Name="AudioStatus" Text="选择耳机后刷新音频设备。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"><Grid><TextBlock Text="系统媒体控制" Style="{StaticResource Hint}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="Previous_Click" ToolTip="上一曲" AutomationProperties.Name="上一曲" Style="{StaticResource IconButton}"><TextBlock Text="&#xE892;" Style="{StaticResource Glyph}" FontSize="14"/></Button><Button Click="Play_Click" Content="播放 / 暂停" Margin="6,0"/><Button Click="Next_Click" ToolTip="下一曲" AutomationProperties.Name="下一曲" Style="{StaticResource IconButton}"><TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="14"/></Button></StackPanel></Grid></Border>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="SoundTab" Padding="14,7" Header="降噪与声音"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel x:Name="SoundStack">
        <Border x:Name="AncCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="聆听模式" Style="{StaticResource Heading}"/>
          <StackPanel x:Name="AncPanel" IsEnabled="False"><ComboBox x:Name="AncChoice" MinHeight="32" SelectionChanged="AncChoice_SelectionChanged" AutomationProperties.Name="聆听模式"/><StackPanel x:Name="AmbientPanel" Margin="0,12,0,0"><Grid><TextBlock Text="环境声强度"/><TextBlock Text="{Binding ElementName=AmbientSlider,Path=Value,StringFormat={}{0:+0;-0;0}}" HorizontalAlignment="Right"/></Grid><Slider x:Name="AmbientSlider" Minimum="-3" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" AutomationProperties.Name="环境声强度"/></StackPanel><Button Content="应用声音模式" Style="{StaticResource Primary}" Click="AncApply_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/></StackPanel>
          <TextBlock x:Name="AncHint" Text="连接后显示此耳机支持的模式。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border x:Name="EqCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="声音预设" Style="{StaticResource Heading}"/><Grid x:Name="EqPanel" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="EqChoice" MinHeight="32" AutomationProperties.Name="声音预设"/><Button Content="应用" Grid.Column="1" Click="EqApply_Click" Margin="6,0,0,0"/></Grid><TextBlock x:Name="EqHint" Text="支持的预设由耳机型号和固件决定。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border x:Name="GameCard" Style="{StaticResource Card}"><StackPanel><Grid x:Name="GamePanel" IsEnabled="False"><CheckBox x:Name="GameEnabled" Content="游戏模式 · 低延迟" VerticalAlignment="Center"/><Button Content="应用" Click="GameApply_Click" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="GameHint" Text="连接后读取游戏模式。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="ControlTab" Padding="14,7" Header="触控"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel x:Name="ControlStack">
        <Border x:Name="CycleCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="降噪键切换顺序" Style="{StaticResource Heading}"/><StackPanel x:Name="CyclePanel" IsEnabled="False"><WrapPanel><CheckBox x:Name="CycleNormal" Content="标准" Margin="0,0,20,10"/><CheckBox x:Name="CycleAnc" Content="降噪" Margin="0,0,20,10"/><CheckBox x:Name="CycleAmbient" Content="环境声" Margin="0,0,0,10"/></WrapPanel><Button Content="应用按键模式" Click="CycleApply_Click" HorizontalAlignment="Right"/></StackPanel><TextBlock x:Name="CycleHint" Text="W820NB 双金标版支持，至少保留两种模式。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border x:Name="TouchCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="触控功能" Style="{StaticResource Heading}"/><StackPanel x:Name="TouchRows"/><Button x:Name="TouchApplyButton" Content="应用触控" Click="TouchApply_Click" HorizontalAlignment="Right" Margin="0,10,0,0" IsEnabled="False"/><TextBlock x:Name="TouchHint" Text="连接 Lolli ANC 后读取可自定义的手势。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><TextBlock Text="耳机自身按键和触控仍可直接使用。这里仅显示已经识别并读取成功的自定义项。" Style="{StaticResource Hint}"/></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="SettingsTab" Padding="14,7" Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel x:Name="SettingsStack">
        <Border x:Name="MultipointCard" Style="{StaticResource Card}"><StackPanel>
          <Grid Margin="0,0,0,8"><TextBlock Text="双设备连接" FontWeight="SemiBold"/><TextBlock x:Name="MultipointStatus" Text="尚未读取" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
          <Grid x:Name="MultipointPanel" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="MultipointEnabled" Content="同时连接两台设备" VerticalAlignment="Center"/><Button x:Name="MultipointApplyButton" Grid.Column="1" Content="应用" Click="MultipointApply_Click" Margin="8,0,0,0"/></Grid>
          <TextBlock x:Name="MultipointHint" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="开启后可连接手机与电脑，切换时可能中断音频。"/>
          <Button x:Name="MultipointSetupButton" Content="打开 Windows 蓝牙设置" Click="BluetoothSettings_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel></Border>
        <Border x:Name="PromptCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="耳机提示音量" Style="{StaticResource Heading}"/><Grid x:Name="PromptPanel" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="PromptSlider" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="提示音音量"/><TextBlock Grid.Column="1" Text="{Binding ElementName=PromptSlider,Path=Value,StringFormat={}{0:F0}/15}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button Grid.Column="2" Content="应用" Click="PromptApply_Click"/></Grid><TextBlock x:Name="PromptHint" Text="连接后读取提示音量。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource Heading}"/><WrapPanel><Button x:Name="ExportButton" Content="导出" Click="Export_Click" Margin="0,0,6,6" IsEnabled="False"/><Button x:Name="ImportButton" Content="导入预览" Click="Import_Click" Margin="0,0,6,6" IsEnabled="False"/><Button x:Name="RestoreButton" Content="应用导入设置" Click="Restore_Click" IsEnabled="False" Margin="0,0,0,6"/></WrapPanel><TextBlock x:Name="ImportText" Text="每次修改前自动备份，写入后重新读取确认。" Style="{StaticResource Hint}"/></StackPanel></Border>
        <Expander Header="诊断与版本信息" Margin="0,0,0,6"><Border Style="{StaticResource Card}" Margin="0,6,0,0"><StackPanel><Button Content="保存诊断报告" Click="Diagnostics_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBox x:Name="LogBox" IsReadOnly="True" Height="120" FontFamily="Consolas" FontSize="10" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><TextBlock x:Name="ProtocolText" Style="{StaticResource Hint}" Margin="0,8,0,0"/><TextBlock Text="0.3.0 · 非官方本地工具 · 尚未完成实机验证。固件升级请使用官方 App。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border></Expander>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="1,7,1,0"><TextBlock x:Name="StatusText" Text="就绪 · 当前版本尚未完成实机验证" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,36,0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/><TextBlock Text="0.3.0" Style="{StaticResource Hint}" HorizontalAlignment="Right" FontSize="10"/></Grid>
  </Grid>
</Window>
